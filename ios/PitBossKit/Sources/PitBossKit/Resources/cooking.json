  "methods" : [
    {
      "grillTemp" : 250,
      "name" : "Texas crutch",
      "note" : "Paper breathes and keeps bark; foil traps steam and is quicker but softens it. The stall is evaporative cooling, not a problem with your fire.",
      "steps" : [
        {
          "detail" : "Run until the bark is set and the internal temperature stalls, usually 160–170°.",
          "grillTemp" : 250,
          "title" : "Smoke bare"
        },
        {
          "detail" : "Butcher paper for a firmer bark, foil to go faster and softer.",
          "grillTemp" : 250,
          "title" : "Wrap"
        },
        {
          "detail" : "Back on until probe tender — 203° for slicing.",
          "grillTemp" : 250,
          "title" : "Finish"
        }
      ],
      "summary" : "Wrap at the stall to push through it and keep the bark from drying."
    },
    {
      "grillTemp" : 300,
      "name" : "Hot and fast",
      "note" : "Roughly 8 hours rather than 12–16. The long rest matters more here than the cook temperature.",
      "steps" : [
        {
          "detail" : "275–300° until the stall.",
          "grillTemp" : 300,
          "title" : "Smoke"
        },
        {
          "detail" : "Butcher paper, then back on.",
          "grillTemp" : 300,
          "title" : "Wrap"
        },
        {
          "detail" : "To probe tender, then rest at least an hour.",
          "grillTemp" : 300,
          "title" : "Finish"
        }
      ],
      "summary" : "Brisket at 275–300° instead of 225° — hours shorter, barely different."
    },
    {
      "name" : "Reverse sear",
      "note" : "Better than searing first: the meat spends less time in the grey band, so it's pink corner to corner.",
      "steps" : [
        {
          "detail" : "225° until the centre is 10–15° below your target.",
          "grillTemp" : 225,
          "title" : "Low and slow"
